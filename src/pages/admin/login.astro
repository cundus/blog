---
import BaseHead from '../../components/BaseHead.astro';

export const prerender = false;

const hasError = Astro.url.searchParams.get('error') === '1';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Admin login" description="Sign in" />
	</head>
	<body>
		<main class="login">
			<h1>Sign in</h1>
			{hasError && <p role="alert" class="error">Invalid password.</p>}
			<form method="POST" action="/api/auth/login">
				<label>
					Password
					<input type="password" name="password" required autofocus autocomplete="current-password" />
				</label>
				<button type="submit">Sign in</button>
			</form>
		</main>
		<style>
			.login {
				max-width: 360px;
				margin: 4rem auto;
				padding: 0 1.5rem;
			}
			.login label {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				margin-bottom: 1rem;
			}
			.login input {
				padding: 0.5rem 0.6rem;
				font-size: 1rem;
			}
			.login button {
				padding: 0.5rem 1rem;
				font-size: 1rem;
			}
			.error {
				background: #fee;
				border: 1px solid #f99;
				padding: 0.5rem 0.75rem;
				margin-bottom: 1rem;
			}
		</style>
	</body>
</html>
