# Postgres connection (direct postgres://, NOT prisma+postgres:// Accelerate URL)
DATABASE_URL="postgres://user:pass@host:5432/db"

# Bcrypt hash of the admin password. Generate with: node scripts/hash-password.mjs "your password"
ADMIN_PASSWORD_HASH=""

# Random 32+ byte string used to sign session tokens. Generate with: openssl rand -base64 32
SESSION_SECRET=""
